<Window x:Class="AssetTrack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AssetTrack.App.ViewModels"
        xmlns:views="clr-namespace:AssetTrack.App.Views"
        xmlns:conv="clr-namespace:AssetTrack.App.Converters"
        xmlns:controls="clr-namespace:AssetTrack.App.Controls"
        Title="AssetTrack" Height="720" Width="1080" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="StringEqualsConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssetsListViewModel}">
            <views:AssetsListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssetDetailViewModel}">
            <views:AssetDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersListViewModel}">
            <views:UsersListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserDetailViewModel}">
            <views:UserDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityLogViewModel}">
            <views:ActivityLogView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4,4,0,24">
                    <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="6" Width="24" Height="24" />
                    <TextBlock Text="AssetTrack" Style="{StaticResource H2Text}" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- User footer -->
                <Grid DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentGreenSoftBrush}" CornerRadius="16" Width="32" Height="32">
                        <TextBlock Text="{Binding CurrentUserInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserDisplayName}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentUserRoleLabel}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Sign out" Style="{StaticResource LinkButton}"
                            Command="{Binding SignOutCommand}" />
                </Grid>

                <!-- Nav items -->
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItemButton}" GroupName="Nav" Content="Dashboard"
                                 IsChecked="{Binding ActiveNav, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                 Command="{Binding GoDashboardCommand}" />
                    <RadioButton Style="{StaticResource NavItemButton}" GroupName="Nav" Content="{Binding AssetsNavLabel}" Margin="0,4,0,0"
                                 IsChecked="{Binding ActiveNav, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Assets, Mode=OneWay}"
                                 Command="{Binding GoAssetsCommand}" />
                    <RadioButton Style="{StaticResource NavItemButton}" GroupName="Nav" Content="Users" Margin="0,4,0,0"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding ActiveNav, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Users, Mode=OneWay}"
                                 Command="{Binding GoUsersCommand}" />
                    <RadioButton Style="{StaticResource NavItemButton}" GroupName="Nav" Content="Activity" Margin="0,4,0,0"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding ActiveNav, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Activity, Mode=OneWay}"
                                 Command="{Binding GoActivityCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
            <controls:AppFooter />
        </Border>
    </Grid>
</Window>
