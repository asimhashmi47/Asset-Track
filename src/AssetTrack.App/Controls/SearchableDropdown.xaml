<UserControl x:Class="AssetTrack.App.Controls.SearchableDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Input" Style="{StaticResource AppTextBox}" Padding="10,8,28,8"
                 Text="{Binding TypedText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="Input_PreviewKeyDown"
                 GotKeyboardFocus="Input_GotKeyboardFocus"
                 PreviewMouseLeftButtonDown="Input_PreviewMouseLeftButtonDown"
                 LostKeyboardFocus="Input_LostKeyboardFocus" />

        <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,11,0"
              IsHitTestVisible="False" />

        <!-- StaysOpen=True on purpose: a StaysOpen=False popup captures the mouse, so the click
             that dismisses it never reaches the button underneath and the user has to click
             twice. This one is closed explicitly when the input loses focus. -->
        <Popup x:Name="Suggestions" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="None"
               Width="{Binding ActualWidth, ElementName=Input}">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,2,0,0" Padding="3">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.14" BlurRadius="12" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <ListBox x:Name="SuggestionList" ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Focusable="False" MaxHeight="210" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonDown="SuggestionList_PreviewMouseLeftButtonDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="9,6" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGreenSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
