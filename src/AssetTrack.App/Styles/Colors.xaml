<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base palette from the Claude Design source of truth -->
    <Color x:Key="BackgroundColor">#F9F8F6</Color>
    <Color x:Key="AccentGreenColor">#9AB17A</Color>
    <Color x:Key="AccentGreenSoftColor">#C3CC9B</Color>
    <Color x:Key="AccentSandColor">#E4DFB5</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EFE9E3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F3F0EB" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2DDD4" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" Opacity="0.9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#000000" Opacity="0.55" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#000000" Opacity="0.4" />

    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentGreenSoftBrush" Color="{StaticResource AccentGreenSoftColor}" />
    <SolidColorBrush x:Key="AccentSandBrush" Color="{StaticResource AccentSandColor}" />
    <SolidColorBrush x:Key="AccentGreenDarkBrush" Color="#5F7A46" />

    <!-- Status badges -->
    <SolidColorBrush x:Key="StatusAssignedBgBrush" Color="#DCE7CC" />
    <SolidColorBrush x:Key="StatusAssignedFgBrush" Color="#3F5B2A" />
    <SolidColorBrush x:Key="StatusAvailableBgBrush" Color="#EFE6C8" />
    <SolidColorBrush x:Key="StatusAvailableFgBrush" Color="#6B5A22" />
    <SolidColorBrush x:Key="StatusRepairBgBrush" Color="#F3DAC0" />
    <SolidColorBrush x:Key="StatusRepairFgBrush" Color="#8A4E1D" />
    <SolidColorBrush x:Key="StatusScrapBgBrush" Color="#F0D2D2" />
    <SolidColorBrush x:Key="StatusScrapFgBrush" Color="#8A2E2E" />

    <SolidColorBrush x:Key="DangerBrush" Color="#B3432B" />

    <!-- Tables -->
    <SolidColorBrush x:Key="RowStripeBrush" Color="#F7F5F2" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#000000" Opacity="0.06" />
</ResourceDictionary>
