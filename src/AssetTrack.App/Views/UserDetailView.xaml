<UserControl x:Class="AssetTrack.App.Views.UserDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AssetTrack.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:AssetStatusToLabelConverter x:Key="StatusLabel" />
        <conv:AssetStatusToBrushConverter x:Key="StatusBrush" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:ActivityEventTypeToLabelConverter x:Key="EventTypeLabel" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <Button Content="{Binding BackLabel}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Command="{Binding BackCommand}" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding User.DisplayName}" Style="{StaticResource H1Text}" Margin="0,0,10,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            Command="{Binding EditCommand}" />
                    <Button Content="Allocate to this user" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            Command="{Binding AllocateToUserCommand}" />
                </StackPanel>
            </Grid>
            <TextBlock Margin="0,0,0,20" Style="{StaticResource SubtleText}">
                <Run Text="{Binding User.Username, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding User.Company, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{Binding User.Division, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding User.City, Mode=OneWay}" />
            </TextBlock>

            <UniformGrid Columns="2" Margin="0,0,0,20">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Currently holding" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding CurrentlyAssigned.Count}" Style="{StaticResource StatNumberText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Assets ever held" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding FullHistory.Count}" Style="{StaticResource StatNumberText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton Style="{StaticResource ChipToggleButton}" Content="Currently assigned" GroupName="Tab" Margin="0,0,8,0"
                             IsChecked="{Binding ShowFullHistory, Converter={StaticResource InverseBool}}"
                             Command="{Binding ShowCurrentTabCommand}" />
                <RadioButton Style="{StaticResource ChipToggleButton}" Content="Full history" GroupName="Tab"
                             IsChecked="{Binding ShowFullHistory}"
                             Command="{Binding ShowHistoryTabCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding CurrentlyAssigned}" Visibility="{Binding ShowFullHistory, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2Text}" FontSize="14" />
                                    <Border Grid.Column="1" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}"
                                            CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Fg}"
                                                   Style="{StaticResource StatusBadgeText}" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,10">
                                    <Run Text="{Binding AssetTag, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SubtleText}" Margin="0,0,0,10">
                                    <Run Text="Serial " /><Run Text="{Binding SerialNumber, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="Record return" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.RecordReturnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding FullHistory}" Visibility="{Binding ShowFullHistory, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding EventType, Converter={StaticResource EventTypeLabel}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding TimestampUtc, StringFormat='d MMM yyyy, HH:mm'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}">
                                    <Run Text="Note: " /><Run Text="{Binding Notes, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
