<UserControl x:Class="AssetTrack.App.Views.AssetsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AssetTrack.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:AssetStatusToLabelConverter x:Key="StatusLabel" />
        <conv:AssetStatusToBrushConverter x:Key="StatusBrush" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:SortIndicatorVisibilityConverter x:Key="SortIndicatorVisibility" />
        <conv:SortDirectionArrowConverter x:Key="SortDirectionArrow" />
        <conv:EnumEqualsConverter x:Key="StringEqualsConverter" />

        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource SortableHeaderButton}">
            <Setter Property="Command" Value="{Binding DataContext.SortByColumnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Assets" Style="{StaticResource H1Text}" />
                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} assets tracked'}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Download Excel" Style="{StaticResource DownloadExcelButton}" Margin="0,0,8,0"
                        Command="{Binding ExportToExcelCommand}" />
                <Button Content="Add asset" Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        Command="{Binding AddAssetCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBox Style="{StaticResource SearchTextBox}" Width="240" Margin="0,0,10,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search name, ID, serial, user" />
            <RadioButton Style="{StaticResource ChipToggleButton}" GroupName="StatusFilter" Content="All" Margin="0,0,6,0"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter={x:Null}, Mode=OneWay}"
                         Command="{Binding ClearStatusFilterCommand}" />
            <RadioButton Style="{StaticResource ChipToggleButton}" GroupName="StatusFilter" Content="Assigned" Margin="0,0,6,0"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Assigned, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="Assigned" />
            <RadioButton Style="{StaticResource ChipToggleButton}" GroupName="StatusFilter" Content="Available" Margin="0,0,6,0"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Available, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="Available" />
            <RadioButton Style="{StaticResource ChipToggleButton}" GroupName="StatusFilter" Content="Repair" Margin="0,0,6,0"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Repair, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="Repair" />
            <RadioButton Style="{StaticResource ChipToggleButton}" GroupName="StatusFilter" Content="Scrap"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Scrap, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="Scrap" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <DataGrid x:Name="AssetsGrid" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Assets}"
                          Visibility="{Binding TotalCount, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"
                          MouseDoubleClick="AssetsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding AssetTag}" Width="80">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource SortHeader}" CommandParameter="AssetTag">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ID" />
                                        <TextBlock Margin="4,0,0,0" FontSize="9"
                                                   Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=AssetTag}"
                                                   Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Name}" Width="1.4*">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource SortHeader}" CommandParameter="Name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ASSET" />
                                        <TextBlock Margin="4,0,0,0" FontSize="9"
                                                   Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=Name}"
                                                   Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Category}" Width="*">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource SortHeader}" CommandParameter="Category">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CATEGORY" />
                                        <TextBlock Margin="4,0,0,0" FontSize="9"
                                                   Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=Category}"
                                                   Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding SerialNumber}" Width="*">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource SortHeader}" CommandParameter="SerialNumber">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SERIAL" />
                                        <TextBlock Margin="4,0,0,0" FontSize="9"
                                                   Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=SerialNumber}"
                                                   Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.Header>
                                <Button Style="{StaticResource SortHeader}" CommandParameter="Status">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="STATUS" />
                                        <TextBlock Margin="4,0,0,0" FontSize="9"
                                                   Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=Status}"
                                                   Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                    </StackPanel>
                                </Button>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}"
                                            CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Fg}"
                                                   Style="{StaticResource StatusBadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding CurrentUser.DisplayName}" Width="1.1*">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource SortHeader}" CommandParameter="CurrentUser">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CURRENT USER" />
                                        <TextBlock Margin="4,0,0,0" FontSize="9"
                                                   Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=CurrentUser}"
                                                   Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No assets match your search." Style="{StaticResource SubtleText}" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding TotalCount, Converter={StaticResource CountToVisibility}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SubtleText}" VerticalAlignment="Center">
                <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" total" />
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding Page, StringFormat='Page {0} of '}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding TotalPages}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Previous" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding PreviousPageCommand}" />
                <Button Content="Next" Style="{StaticResource SecondaryButton}" Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
