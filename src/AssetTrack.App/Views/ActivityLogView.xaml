<UserControl x:Class="AssetTrack.App.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AssetTrack.App.Converters"
             xmlns:local="clr-namespace:AssetTrack.App.ViewModels">
    <UserControl.Resources>
        <conv:ActivityEventTypeToLabelConverter x:Key="EventTypeLabel" />
        <conv:SortIndicatorVisibilityConverter x:Key="SortIndicatorVisibility" />
        <conv:SortDirectionArrowConverter x:Key="SortDirectionArrow" />
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource SortableHeaderButton}">
            <Setter Property="Command" Value="{Binding DataContext.SortByColumnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Activity log" Style="{StaticResource H1Text}" />
                <TextBlock Text="{Binding TotalCount, StringFormat='Admin only · {0} recorded events'}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Download Excel" Style="{StaticResource DownloadExcelButton}" VerticalAlignment="Top"
                    Command="{Binding ExportToExcelCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Filter:" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Style="{StaticResource AppComboBox}" Width="200"
                      ItemsSource="{x:Static local:ActivityLogViewModel.EventTypes}"
                      SelectedItem="{Binding EventTypeFilter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EventTypeLabel}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Clear filter" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                    Click="ClearFilter_Click" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" VerticalAlignment="Top">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Entries}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding TimestampUtc, StringFormat='d MMM yyyy, HH:mm'}" Width="1.3*">
                        <DataGridTextColumn.Header>
                            <Button Style="{StaticResource SortHeader}" CommandParameter="Timestamp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TIMESTAMP" />
                                    <TextBlock Margin="4,0,0,0" FontSize="9"
                                               Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=Timestamp}"
                                               Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                </StackPanel>
                            </Button>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ActorUser.DisplayName}" Width="*">
                        <DataGridTextColumn.Header>
                            <Button Style="{StaticResource SortHeader}" CommandParameter="Actor">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ACTOR" />
                                    <TextBlock Margin="4,0,0,0" FontSize="9"
                                               Visibility="{Binding DataContext.SortBy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortIndicatorVisibility}, ConverterParameter=Actor}"
                                               Text="{Binding DataContext.SortAscending, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource SortDirectionArrow}}" />
                                </StackPanel>
                            </Button>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ACTION" Binding="{Binding EventType, Converter={StaticResource EventTypeLabel}}" Width="*" />
                    <DataGridTextColumn Header="ENTITY" Binding="{Binding Asset.AssetTag}" Width="80" />
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="1.4*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SubtleText}" VerticalAlignment="Center">
                <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" total" />
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding Page, StringFormat='Page {0} of '}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding TotalPages}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Previous" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding PreviousPageCommand}" />
                <Button Content="Next" Style="{StaticResource SecondaryButton}" Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
