<Window x:Class="AssetTrack.App.Views.AddAssetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AssetTrack.App.Converters"
        xmlns:controls="clr-namespace:AssetTrack.App.Controls"
        xmlns:enums="clr-namespace:AssetTrack.Core.Enums;assembly=AssetTrack.Core"
        Title="Add asset" SizeToContent="Height" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BusyTextConverter x:Key="BusyTextConverter" />
        <conv:NullableIntConverter x:Key="NullableIntConverter" />
        <Style x:Key="FieldColumn" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="Add asset" Style="{StaticResource H2Text}" />
            <TextBlock Text="New assets start as Available." Style="{StaticResource SubtleText}" Margin="0,2,0,16" />

            <StackPanel Style="{StaticResource FieldColumn}">
                <TextBlock Text="Asset name" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                    <controls:SearchableDropdown Kind="{x:Static enums:LookupKind.Category}" SelectedValue="{Binding Category}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Serial number" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Make (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Make, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Model (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Year (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntConverter}}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Company" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
            </Grid>

            <StackPanel Style="{StaticResource FieldColumn}" Margin="0,0,0,10">
                <TextBlock Text="Date added" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding DateAdded}" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" Width="90" />
                <Button Content="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Save|Saving…'}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Width="90" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
