<Window x:Class="AssetTrack.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AssetTrack.App.Converters"
        xmlns:controls="clr-namespace:AssetTrack.App.Controls"
        Title="AssetTrack" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BusyTextConverter x:Key="BusyTextConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:AppFooter Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,5,14" Panel.ZIndex="1" />

        <!-- Left: sign-in form -->
        <StackPanel Grid.Column="0" Margin="48" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="8" Width="32" Height="32" />
                <TextBlock Text="AssetTrack" Style="{StaticResource H2Text}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Text="Sign in" Style="{StaticResource H1Text}" Margin="0,0,0,8" />
            <TextBlock Text="Track who holds every laptop, monitor and cable — and everyone who held it before."
                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,24" />

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UsernameBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,16"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,8"
                         PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,4,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <Button Content="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Sign in|Signing in…'}"
                    Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                    Command="{Binding SignInCommand}" IsDefault="True" />

            <Separator Margin="0,20" Opacity="0.3" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Demo access — fill credentials for " Style="{StaticResource CaptionText}" />
                <Button Content="admin" Style="{StaticResource LinkButton}" Click="FillAdmin_Click" Padding="0" />
                <TextBlock Text=" or " Style="{StaticResource CaptionText}" />
                <Button Content="a staff user" Style="{StaticResource LinkButton}" Click="FillStaff_Click" Padding="0" />
            </StackPanel>
        </StackPanel>

        <!-- Right: accent panel -->
        <Border Grid.Column="1" Background="{StaticResource AccentGreenSoftBrush}">
            <Grid Margin="40">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="20"
                        VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="320">
                    <StackPanel>
                        <TextBlock Text="ASSET AT-1001" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="MacBook Pro 14&quot;" Style="{StaticResource H2Text}" Margin="0,4,0,10" />
                        <TextBlock Text="• Allocated to Joe · 12 Mar 2026" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                        <TextBlock Text="• Added to inventory · 18 Jan 2026" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Every allocation, return and disposal is kept. Records are never deleted."
                           Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Bottom"
                           HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.75" />
            </Grid>
        </Border>
    </Grid>
</Window>
