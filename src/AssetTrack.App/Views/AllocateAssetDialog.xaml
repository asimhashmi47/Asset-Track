<Window x:Class="AssetTrack.App.Views.AllocateAssetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AssetTrack.App.Converters"
        Title="Allocate asset" SizeToContent="Height" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BusyTextConverter x:Key="BusyTextConverter" />
        <conv:AssetDisplayConverter x:Key="AssetDisplayConverter" />
    </Window.Resources>
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="Allocate asset" Style="{StaticResource H2Text}" />
            <TextBlock Text="Only available assets can be allocated." Style="{StaticResource SubtleText}" Margin="0,2,0,16" />

            <TextBlock Text="Asset" Style="{StaticResource FieldLabel}" />
            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,14"
                      ItemsSource="{Binding AvailableAssets}" SelectedItem="{Binding SelectedAsset}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource AssetDisplayConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Allocate to" Style="{StaticResource FieldLabel}" />
            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,14"
                      ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                      DisplayMemberPath="DisplayName" />

            <TextBlock Text="Allocation date" Style="{StaticResource FieldLabel}" />
            <DatePicker Margin="0,0,0,14" SelectedDate="{Binding AllocationDate}" />

            <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Style="{StaticResource AppTextBox}" Margin="0,0,0,10" Text="{Binding Notes}" />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" Width="90" />
                <Button Content="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Save|Saving…'}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Width="90" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
