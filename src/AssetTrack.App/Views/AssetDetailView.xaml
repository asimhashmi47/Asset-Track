<UserControl x:Class="AssetTrack.App.Views.AssetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AssetTrack.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:AssetStatusToLabelConverter x:Key="StatusLabel" />
        <conv:AssetStatusToBrushConverter x:Key="StatusBrush" />
        <conv:ActivityEventTypeToLabelConverter x:Key="EventTypeLabel" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <Button Content="&#8592; All assets" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Command="{Binding BackCommand}" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Asset.AssetTag}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Background="{Binding Asset.Status, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}"
                            CornerRadius="10" Padding="8,3">
                        <TextBlock Text="{Binding Asset.Status, Converter={StaticResource StatusLabel}}"
                                   Foreground="{Binding Asset.Status, Converter={StaticResource StatusBrush}, ConverterParameter=Fg}"
                                   Style="{StaticResource StatusBadgeText}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                            Command="{Binding EditCommand}" />
                    <Button Content="Record return" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding CanReturn, Converter={StaticResource BoolToVis}}"
                            Command="{Binding RecordReturnCommand}" />
                    <Button Content="Mark as scrap" Style="{StaticResource DangerButton}"
                            Visibility="{Binding CanScrap, Converter={StaticResource BoolToVis}}"
                            Command="{Binding MarkScrapCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Asset.Name}" Style="{StaticResource H1Text}" Margin="0,6,0,4" />
            <TextBlock Margin="0,0,0,20" Style="{StaticResource SubtleText}">
                <Run Text="{Binding Asset.Category, Mode=OneWay}" /><Run Text=" · Serial " /><Run Text="{Binding Asset.SerialNumber, Mode=OneWay}" />
                <Run Text=" · Added " /><Run Text="{Binding Asset.CreatedAtUtc, StringFormat='d MMM yyyy', Mode=OneWay}" />
            </TextBlock>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="CURRENT OWNERSHIP" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Asset.CurrentUser.DisplayName, TargetNullValue='No current owner'}" Style="{StaticResource H2Text}" FontSize="15" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                                   Visibility="{Binding CurrentOwnershipSince, Converter={StaticResource NullToVisibilityConverter}}">
                            <Run Text="Since " /><Run Text="{Binding CurrentOwnershipSince, StringFormat='d MMM yyyy', Mode=OneWay}" />
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Style="{StaticResource CaptionText}" Margin="0,0,10,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Asset.Company}" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Division" Style="{StaticResource CaptionText}" Margin="0,0,10,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Asset.Division}" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="City" Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Asset.City}" Style="{StaticResource BodyText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="IDENTITY" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Asset ID" Style="{StaticResource CaptionText}" Margin="0,0,10,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Asset.AssetTag}" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Style="{StaticResource CaptionText}" Margin="0,0,10,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Asset.Category}" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial" Style="{StaticResource CaptionText}" Margin="0,0,10,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Asset.SerialNumber}" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Added" Style="{StaticResource CaptionText}" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Asset.CreatedAtUtc, StringFormat='d MMM yyyy'}" Style="{StaticResource BodyText}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Full history" Style="{StaticResource H2Text}" />
                    <TextBlock Text="Every allocation, return and disposal — never deleted." Style="{StaticResource SubtleText}" Margin="0,2,0,14" />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding EventType, Converter={StaticResource EventTypeLabel}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding TimestampUtc, StringFormat='d MMM yyyy, HH:mm'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}">
                                            <Run Text="Note: " /><Run Text="{Binding Notes, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
