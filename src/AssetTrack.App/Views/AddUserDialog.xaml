<Window x:Class="AssetTrack.App.Views.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AssetTrack.App.Converters"
        xmlns:local="clr-namespace:AssetTrack.App.ViewModels"
        xmlns:controls="clr-namespace:AssetTrack.App.Controls"
        xmlns:enums="clr-namespace:AssetTrack.Core.Enums;assembly=AssetTrack.Core"
        Title="Add user" SizeToContent="Height" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BusyTextConverter x:Key="BusyTextConverter" />
        <conv:UserRoleToLabelConverter x:Key="UserRoleToLabelConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="FieldColumn" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="Add user" Style="{StaticResource H2Text}" Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                    <!-- One input-looking box, but the Show/Hide toggle is its own segment behind a
                         divider, so it doesn't read as text sitting inside the field. -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <PasswordBox x:Name="PasswordBoxInput" Style="{StaticResource AppPasswordBox}"
                                             BorderThickness="0" Background="Transparent" Padding="10,8"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBox x:Name="PasswordTextInput" Style="{StaticResource AppTextBox}"
                                         BorderThickness="0" Background="Transparent" Padding="10,8"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                <Button Content="{Binding IsPasswordVisible, Converter={StaticResource BusyTextConverter}, ConverterParameter='Show|Hide'}"
                                        Style="{StaticResource LinkButton}" Padding="11,0" FontSize="11" MinWidth="46"
                                        Command="{Binding TogglePasswordVisibilityCommand}" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource AppComboBox}"
                              ItemsSource="{x:Static local:AddUserDialogViewModel.Roles}" SelectedItem="{Binding Role}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource UserRoleToLabelConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Designation" Style="{StaticResource FieldLabel}" />
                    <controls:SearchableDropdown Kind="{x:Static enums:LookupKind.Designation}" SelectedValue="{Binding Designation}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Department" Style="{StaticResource FieldLabel}" />
                    <controls:SearchableDropdown Kind="{x:Static enums:LookupKind.Department}" SelectedValue="{Binding Department}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Company name" Style="{StaticResource FieldLabel}" />
                    <controls:SearchableDropdown Kind="{x:Static enums:LookupKind.Company}" SelectedValue="{Binding Company}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="City" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Contact (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" Width="90" />
                <Button Content="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Save|Saving…'}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Width="90" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
