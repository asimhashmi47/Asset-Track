<Window x:Class="AssetTrack.App.Views.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AssetTrack.App.Converters"
        xmlns:local="clr-namespace:AssetTrack.App.ViewModels"
        xmlns:controls="clr-namespace:AssetTrack.App.Controls"
        xmlns:enums="clr-namespace:AssetTrack.Core.Enums;assembly=AssetTrack.Core"
        Title="Edit user" SizeToContent="Height" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BusyTextConverter x:Key="BusyTextConverter" />
        <conv:UserRoleToLabelConverter x:Key="UserRoleToLabelConverter" />
        <Style x:Key="FieldColumn" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="Edit user" Style="{StaticResource H2Text}" />
            <TextBlock Text="Username and password aren't changed here." Style="{StaticResource SubtleText}" Margin="0,2,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Username}" IsReadOnly="True" IsTabStop="False"
                             Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource AppComboBox}"
                              ItemsSource="{x:Static local:EditUserDialogViewModel.Roles}" SelectedItem="{Binding Role}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource UserRoleToLabelConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Designation" Style="{StaticResource FieldLabel}" />
                    <controls:SearchableDropdown Kind="{x:Static enums:LookupKind.Designation}" SelectedValue="{Binding Designation}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Department" Style="{StaticResource FieldLabel}" />
                    <controls:SearchableDropdown Kind="{x:Static enums:LookupKind.Department}" SelectedValue="{Binding Department}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldColumn}">
                    <TextBlock Text="Company name" Style="{StaticResource FieldLabel}" />
                    <controls:SearchableDropdown Kind="{x:Static enums:LookupKind.Company}" SelectedValue="{Binding Company}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldColumn}" Margin="0,0,0,10">
                    <TextBlock Text="City" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldColumn}" Margin="0,0,0,10">
                    <TextBlock Text="Contact (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" Width="90" IsCancel="True" />
                <Button Content="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Save|Saving…'}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Width="90" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
