<UserControl x:Class="AssetTrack.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AssetTrack.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Overview" Style="{StaticResource H1Text}" />
                    <TextBlock Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                <Setter Property="Text" Value="What's currently assigned to you." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Text" Value="What is happening with company assets right now." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <Button Content="Record return" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding RecordReturnCommand}" />
                    <Button Content="Allocate asset" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AllocateAssetCommand}" />
                </StackPanel>
            </Grid>

            <!-- Staff: personal summary only, never org-wide numbers -->
            <UniformGrid Columns="2" Margin="0,0,0,20" Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Background="{StaticResource AccentGreenSoftBrush}">
                    <StackPanel>
                        <TextBlock Text="Currently holding" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding MyCurrentAssetCount}" Style="{StaticResource StatNumberText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Assets ever held" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding MyEverHeldCount}" Style="{StaticResource StatNumberText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Admin: org-wide stat cards -->
            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,20" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource ClickableCard}" Margin="0,0,10,10" Background="{StaticResource SurfaceBrush}"
                        Command="{Binding OpenAssetsFilteredCommand}" CommandParameter="{x:Null}" ToolTip="View all assets">
                    <StackPanel>
                        <TextBlock Text="Total assets" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Summary.TotalAssets}" Style="{StaticResource StatNumberText}" />
                        <TextBlock Text="across all companies" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ClickableCard}" Margin="0,0,10,10" Background="{StaticResource AccentGreenSoftBrush}"
                        Command="{Binding OpenAssetsFilteredCommand}" CommandParameter="Assigned" ToolTip="View assigned assets">
                    <StackPanel>
                        <TextBlock Text="Currently assigned" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Summary.Assigned}" Style="{StaticResource StatNumberText}" />
                        <TextBlock Text="in employee hands" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ClickableCard}" Margin="0,0,0,10" Background="{StaticResource AccentSandBrush}"
                        Command="{Binding OpenAssetsFilteredCommand}" CommandParameter="Available" ToolTip="View available assets">
                    <StackPanel>
                        <TextBlock Text="Available" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Summary.Available}" Style="{StaticResource StatNumberText}" />
                        <TextBlock Text="ready to allocate" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ClickableCard}" Margin="0,0,10,0" Background="{StaticResource SurfaceBrush}"
                        Command="{Binding OpenReturnsActivityCommand}" ToolTip="View return history">
                    <StackPanel>
                        <TextBlock Text="Returns recorded" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Summary.ReturnsRecorded}" Style="{StaticResource StatNumberText}" />
                        <TextBlock Text="all time" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ClickableCard}" Margin="0,0,10,0" Background="{StaticResource StatusRepairBgBrush}"
                        Command="{Binding OpenAssetsFilteredCommand}" CommandParameter="Repair" ToolTip="View assets in repair">
                    <StackPanel>
                        <TextBlock Text="In repair" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Summary.Repair}" Style="{StaticResource StatNumberText}" />
                        <TextBlock Text="awaiting outcome" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ClickableCard}" Background="{StaticResource StatusScrapBgBrush}"
                        Command="{Binding OpenAssetsFilteredCommand}" CommandParameter="Scrap" ToolTip="View scrapped assets">
                    <StackPanel>
                        <TextBlock Text="Scrapped" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Summary.Scrap}" Style="{StaticResource StatNumberText}" />
                        <TextBlock Text="history retained" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Status distribution" Style="{StaticResource H2Text}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Assigned" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{Binding Summary.Assigned}" Style="{StaticResource SubtleText}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Available" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{Binding Summary.Available}" Style="{StaticResource SubtleText}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Repair" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{Binding Summary.Repair}" Style="{StaticResource SubtleText}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Scrap" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{Binding Summary.Scrap}" Style="{StaticResource SubtleText}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="By category" Style="{StaticResource H2Text}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Height="8" VerticalAlignment="Center">
                                            <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="4" HorizontalAlignment="Left"
                                                    Width="{Binding Fraction, Converter={x:Static conv:FractionToWidthConverter.Instance}}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource H2Text}">
                                <Setter Property="Text" Value="My activity" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Text" Value="Recent activity" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap">
                                        <Run Text="•" />
                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionText}">
                                        <Run Text="{Binding TimestampUtc, StringFormat='d MMM yyyy, HH:mm', Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
