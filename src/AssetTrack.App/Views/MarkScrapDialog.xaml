<Window x:Class="AssetTrack.App.Views.MarkScrapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AssetTrack.App.Converters"
        Title="Mark as scrap" SizeToContent="Height" Width="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BusyTextConverter x:Key="BusyTextConverter" />
    </Window.Resources>
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="Mark as scrap" Style="{StaticResource H2Text}" />
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,2,0,4" TextWrapping="Wrap">
                <Run Text="{Binding AssetName, Mode=OneWay}" /><Run Text=" will be marked as scrap and removed from service. Its ownership history is kept, never deleted." />
            </TextBlock>
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,0,0,4" TextWrapping="Wrap"
                       Visibility="{Binding HolderName, Converter={StaticResource StringToVisibilityConverter}}">
                <Run Text="It is currently assigned to " /><Run Text="{Binding HolderName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — scrapping it will end that assignment." />
            </TextBlock>
            <TextBlock Text="This cannot be undone." Style="{StaticResource ErrorText}" Margin="0,0,0,16" />

            <TextBlock Text="Reason / notes (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Style="{StaticResource AppTextBox}" Margin="0,0,0,10" Text="{Binding Notes}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" Width="90" />
                <Button Content="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Mark as scrap|Saving…'}"
                        Style="{StaticResource DangerButton}" Command="{Binding ConfirmCommand}" Width="130" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
